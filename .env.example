# Neon pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Owner login. Use a unique strong password; ADMIN_PASSWORD_HASH is preferred.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Generate a random secret of at least 32 characters.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Recommended: bcrypt hash instead of storing plain password in environment.
# ADMIN_PASSWORD_HASH=$2b$12$...
# Persistent direct uploads (Cloudinary free tier may be available; check their current terms/limits).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
